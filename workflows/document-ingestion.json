          "cachedResultName": "Configure this folder after import"
        },
        "event": "fileCreated",
        "options": {}
      },
      "type": "n8n-nodes-base.googleDriveTrigger",
      "typeVersion": 1,
      "position": [
        -160,
        -160
      ],
      "id": "e771147c-ade8-48b3-9f9f-d5d62ba5cb34",
      "name": "Google Drive Trigger"
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "value": "={{ $json.id }}",
          "mode": "id"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        64,
        -160
      ],
      "id": "d4b77b6c-aa9f-4761-89d4-5947bcf14c18",
